{
  "$comment": "COS-PLUGIN-002 WP2-01 tool-contracts.md semantic JSON Schema bundle (Draft 2020-12, draft-07-compatible subset), copied verbatim from cos-share/plans/plugin2/specs/tool-contracts.md revision r1 (file sha256 e0c97d0a789fd4d3bfc023719dfce10704df6e915748343604a9bf13e76a5dcd). Source of truth for the discoverability tools' semantics; src/tools/discoverability.test.ts checks the registered Zod schemas and the generated tools/list schemas against it with one corpus. Do not edit by hand; re-copy from the spec.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robynn:discoverability:tools:v1",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "engine": {
      "type": "string",
      "enum": [
        "chatgpt",
        "claude",
        "gemini",
        "perplexity"
      ]
    },
    "experiment_type": {
      "type": "string",
      "enum": [
        "title_meta",
        "answer_first",
        "evidence_block",
        "faq",
        "brand_fact",
        "structured_data",
        "internal_links",
        "comparison_page"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^/(?!/)[^?#\\\\]*$"
    },
    "evidence": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "scan",
            "gsc",
            "panel",
            "crawl",
            "claim",
            "experiment"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "id",
        "summary",
        "observed_at"
      ],
      "additionalProperties": false
    },
    "freshness": {
      "type": "object",
      "properties": {
        "generated_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "as_of": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "available",
            "stale",
            "partial",
            "unavailable"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "generated_at",
        "as_of",
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    "interval": {
      "type": "object",
      "properties": {
        "estimate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "lower90": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "upper90": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": "string",
          "enum": [
            "percent",
            "percentage_points",
            "fraction",
            "count"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "evidence_label": {
          "type": "string",
          "enum": [
            "randomized",
            "observational",
            "descriptive"
          ]
        },
        "expected_n": {
          "type": "integer",
          "minimum": 0
        },
        "observed_n": {
          "type": "integer",
          "minimum": 0
        },
        "clusters": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "estimate",
        "lower90",
        "upper90",
        "unit",
        "method",
        "evidence_label",
        "expected_n",
        "observed_n",
        "clusters"
      ],
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "blocker"
          ]
        },
        "page_path": {
          "anyOf": [
            {
              "$ref": "#/$defs/path"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 0,
          "maxItems": 20
        }
      },
      "required": [
        "code",
        "severity",
        "page_path",
        "message",
        "evidence"
      ],
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "report_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "validator_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "claim_version_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence_freshness": {
          "$ref": "#/$defs/freshness"
        }
      },
      "required": [
        "valid",
        "report_hash",
        "validator_version",
        "issues",
        "claim_version_ids",
        "content_hash",
        "evidence_freshness"
      ],
      "additionalProperties": false
    },
    "cost": {
      "type": "object",
      "properties": {
        "currency": {
          "const": "USD"
        },
        "estimated_microusd": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_microusd": {
          "type": "integer",
          "minimum": 0
        },
        "budget_remaining_microusd": {
          "type": "integer",
          "minimum": 0
        },
        "rate_card_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "credits_charged": {
          "const": false
        }
      },
      "required": [
        "currency",
        "estimated_microusd",
        "maximum_microusd",
        "budget_remaining_microusd",
        "rate_card_version",
        "credits_charged"
      ],
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "properties": {
        "page_path": {
          "$ref": "#/$defs/path"
        },
        "field": {
          "type": "string",
          "enum": [
            "title",
            "meta_description",
            "h1",
            "intro",
            "body_block",
            "faq",
            "schema_jsonld",
            "internal_link",
            "new_page"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "selector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "before_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "delivery_binding_id": {
          "type": "string",
          "format": "uuid"
        },
        "claim_version_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 0,
          "maxItems": 50
        }
      },
      "required": [
        "page_path",
        "field",
        "content",
        "before_hash",
        "delivery_binding_id"
      ],
      "additionalProperties": false
    },
    "proposal": {
      "type": "object",
      "properties": {
        "proposal_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "diagnostic_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "title_meta",
            "answer_first",
            "evidence_block",
            "faq",
            "brand_fact",
            "structured_data",
            "internal_links",
            "comparison_page"
          ]
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "minItems": 1,
          "maxItems": 25
        },
        "design": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "evidence_label": {
          "type": "string",
          "enum": [
            "randomized",
            "observational",
            "descriptive"
          ]
        },
        "expected_impact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "minimum_days": {
          "type": "integer",
          "minimum": 21,
          "maximum": 84
        },
        "cost": {
          "$ref": "#/$defs/cost"
        },
        "eligibility_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 0,
          "maxItems": 30
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 0,
          "maxItems": 20
        }
      },
      "required": [
        "proposal_id",
        "diagnostic_hash",
        "type",
        "hypothesis",
        "pages",
        "design",
        "evidence_label",
        "expected_impact",
        "minimum_days",
        "cost",
        "eligibility_reasons",
        "evidence"
      ],
      "additionalProperties": false
    },
    "guardrail": {
      "type": "object",
      "properties": {
        "metric": {
          "type": "string",
          "enum": [
            "conversion_rate",
            "untreated_clicks",
            "fact_accuracy"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "regressed",
            "unknown"
          ]
        },
        "margin": {
          "type": "number"
        },
        "interval": {
          "$ref": "#/$defs/interval"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "metric",
        "status",
        "margin",
        "interval",
        "reason"
      ],
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "properties": {
        "treated_pages": {
          "type": "integer",
          "minimum": 0
        },
        "delivered_pages": {
          "type": "integer",
          "minimum": 0
        },
        "parity_pass_pages": {
          "type": "integer",
          "minimum": 0
        },
        "recrawled_pages": {
          "type": "integer",
          "minimum": 0
        },
        "exposure_eligible_pages": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "verified",
            "failed",
            "unknown"
          ]
        },
        "last_checked_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "treated_pages",
        "delivered_pages",
        "parity_pass_pages",
        "recrawled_pages",
        "exposure_eligible_pages",
        "status",
        "last_checked_at"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "string",
      "enum": [
        "pending_approval",
        "approved",
        "queued",
        "delivering",
        "measuring",
        "paused",
        "completed",
        "cancelled",
        "rollback_requested",
        "rolling_back",
        "rolled_back",
        "failed"
      ]
    },
    "learning": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "experiment_id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "enum": [
            "title_meta",
            "answer_first",
            "evidence_block",
            "faq",
            "brand_fact",
            "structured_data",
            "internal_links",
            "comparison_page"
          ]
        },
        "page_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "minItems": 0,
          "maxItems": 30
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "effect": {
          "$ref": "#/$defs/interval"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 0,
          "maxItems": 20
        },
        "memory_status": {
          "type": "string",
          "enum": [
            "pending",
            "written",
            "failed"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "experiment_id",
        "type",
        "page_types",
        "summary",
        "effect",
        "evidence",
        "memory_status",
        "created_at"
      ],
      "additionalProperties": false
    },
    "status_item": {
      "type": "object",
      "properties": {
        "experiment_id": {
          "type": "string",
          "format": "uuid"
        },
        "website_id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "days_elapsed": {
          "type": "integer",
          "minimum": 0
        },
        "post_start": {
          "type": "string",
          "format": "date"
        },
        "post_end": {
          "type": "string",
          "format": "date"
        },
        "delivery": {
          "$ref": "#/$defs/delivery"
        },
        "interim": {
          "$ref": "#/$defs/interval"
        },
        "conclusive": {
          "const": false
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "minItems": 0,
          "maxItems": 100
        },
        "freshness": {
          "$ref": "#/$defs/freshness"
        }
      },
      "required": [
        "experiment_id",
        "website_id",
        "state",
        "days_elapsed",
        "post_start",
        "post_end",
        "delivery",
        "interim",
        "conclusive",
        "warnings",
        "freshness"
      ],
      "additionalProperties": false
    },
    "approval_link": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "error": {
      "type": "object",
      "required": [
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "invalid_token",
                "insufficient_scope",
                "membership_inactive",
                "role_forbidden",
                "grant_revoked",
                "authorization_expired",
                "authorization_unavailable",
                "tool_not_permitted",
                "not_found",
                "idempotency_key_reused",
                "idempotency_in_progress",
                "idempotency_outcome_unknown",
                "environment_not_eligible",
                "invalid_request",
                "validation_failed",
                "data_unavailable",
                "design_ineligible",
                "proposal_stale",
                "conflict",
                "internal_error"
              ]
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "required_scope": {
              "type": "string",
              "enum": [
                "brand:read",
                "tools:execute"
              ]
            },
            "request_id": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": false
        }
      }
    }
  },
  "tools": [
    {
      "name": "robynn_site_health",
      "inputSchema": {
        "type": "object",
        "properties": {
          "website_id": {
            "type": "string",
            "format": "uuid"
          },
          "focus": {
            "type": "string",
            "enum": [
              "seo",
              "geo",
              "both"
            ]
          },
          "window_days": {
            "type": "integer",
            "minimum": 7,
            "maximum": 180,
            "default": 28
          }
        },
        "required": [
          "website_id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "website_id": {
            "type": "string",
            "format": "uuid"
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/issue"
            },
            "minItems": 0,
            "maxItems": 100
          },
          "seo": {
            "$ref": "#/$defs/interval"
          },
          "geo": {
            "$ref": "#/$defs/interval"
          },
          "crawl": {
            "$ref": "#/$defs/delivery"
          },
          "freshness": {
            "$ref": "#/$defs/freshness"
          }
        },
        "required": [
          "website_id",
          "issues",
          "seo",
          "geo",
          "crawl",
          "freshness"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "robynn_ai_visibility_trend",
      "inputSchema": {
        "type": "object",
        "properties": {
          "website_id": {
            "type": "string",
            "format": "uuid"
          },
          "panel_id": {
            "type": "string",
            "format": "uuid"
          },
          "engines": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/engine"
            },
            "minItems": 1,
            "maxItems": 4
          },
          "window_days": {
            "type": "integer",
            "minimum": 7,
            "maximum": 180,
            "default": 28
          },
          "competitors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "minItems": 1,
            "maxItems": 10,
            "uniqueItems": true
          }
        },
        "required": [
          "website_id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "website_id": {
            "type": "string",
            "format": "uuid"
          },
          "panel_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "series": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "engine": {
                  "$ref": "#/$defs/engine"
                },
                "topic": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "observation_kind": {
                  "const": "fresh_answer_run"
                },
                "mention": {
                  "$ref": "#/$defs/interval"
                },
                "citation": {
                  "$ref": "#/$defs/interval"
                },
                "share_of_voice": {
                  "$ref": "#/$defs/interval"
                },
                "fact_errors": {
                  "type": "integer",
                  "minimum": 0
                },
                "freshness": {
                  "$ref": "#/$defs/freshness"
                },
                "entity_domain": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253
                },
                "metric_coverage": {
                  "type": "object",
                  "properties": {
                    "expected": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "mention_observed": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "citation_observed": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "expected",
                    "mention_observed",
                    "citation_observed"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "engine",
                "topic",
                "observation_kind",
                "mention",
                "citation",
                "share_of_voice",
                "fact_errors",
                "freshness",
                "entity_domain",
                "metric_coverage"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 500
          },
          "provider_snapshots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "platform": {
                  "type": "string",
                  "enum": [
                    "google",
                    "chat_gpt"
                  ]
                },
                "observation_kind": {
                  "const": "provider_snapshot"
                },
                "distinct_records": {
                  "type": "integer",
                  "minimum": 0
                },
                "provider_observed_at": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "freshness": {
                  "$ref": "#/$defs/freshness"
                }
              },
              "required": [
                "platform",
                "observation_kind",
                "distinct_records",
                "provider_observed_at",
                "freshness"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 20
          },
          "freshness": {
            "$ref": "#/$defs/freshness"
          }
        },
        "required": [
          "website_id",
          "panel_id",
